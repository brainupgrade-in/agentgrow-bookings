# Nebius Token Factory (OpenAI-compatible). Key: https://tokenfactory.nebius.com -> API keys
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Only scripts/smoke.py reads this; the app's models are set in code (overrides below)
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional model overrides (defaults: Nemotron 3 Super for both roles, Qwen3.8-27B for fee-card photos)
# BOOKINGS_MODEL_CUSTOMER=
# BOOKINGS_MODEL_OWNER=
# BOOKINGS_MODEL_VISION=
# Tavily: looks the clinic up during setup to prefill address, hours and website
TAVILY_API_KEY=
# WhatsApp Cloud API (Meta developer app with the WhatsApp use case)
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
# Cashfree Payment Links for no-show deposits (sandbox = test mode, no real money)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Bearer key for the read-only /api/v1 (a CRM pulls new clinics and weekly numbers from it)
BOOKINGS_API_KEY=
# Optional: the clinic owner's WhatsApp number (digits, no +); a placeholder is used until set
# BOOKINGS_OWNER_WA=
# BOOKINGS_DB=data/bookings.db
# BOOKINGS_PUBLIC_URL=https://bookings.agentgrow.io
